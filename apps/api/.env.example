# Copia este archivo como .env. El archivo .env no se sube al repositorio.

# Base de datos de desarrollo que arranca `docker compose up -d`.
DATABASE_URL="postgresql://bingogoals:bingogoals@localhost:5432/bingogoals?schema=public"

# Puerto de la API.
PORT=3000

# Orígenes desde los que la web puede llamar a la API, separados por comas.
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"

# Saltos de proxy delante de la API, para saber la IP real del cliente
# (opcional). En local no hay ninguno; en Render, 1.
# TRUST_PROXY=1

# Límite de intentos de registro e inicio de sesión (opcional).
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MINUTES=15
