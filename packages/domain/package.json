{
  "name": "@bingogoals/domain",
  "private": true,
  "version": "0.0.0",
  "description": "Modelo y reglas del bingo, compartidos por la web y la API.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
