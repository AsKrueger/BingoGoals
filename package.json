{
  "name": "bingogoals",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "npm run build:domain && node scripts/parallel.mjs \"build:watch --workspace @bingogoals/domain\" \"dev --workspace @bingogoals/web\" \"dev --workspace @bingogoals/api\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:domain": "npm run build --workspace @bingogoals/domain",
    "typecheck": "npm run build:domain && npm run typecheck --workspaces",
    "test": "npm run build:domain && npm run test --workspaces",
    "test:integration": "npm run build:domain && npm run test:integration --workspace @bingogoals/api",
    "test:e2e": "npm run build && npm run test:e2e --workspace @bingogoals/web",
    "build": "npm run build --workspaces",
    "db:up": "docker compose up --detach --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace @bingogoals/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true
  }
}
